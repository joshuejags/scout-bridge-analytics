# Copy to .env.aws on the EC2 host and replace every placeholder.
# Keep .env.aws private; never commit it.

NODE_ENV=production
CLIENT_URL=https://scoutbridgeanalytics.com
PORT=5000
JWT_SECRET=replace-with-a-long-random-hex-secret

# Use letters and numbers only in these two values so the Mongo URI remains valid.
MONGO_ROOT_USERNAME=scoutbridge
MONGO_ROOT_PASSWORD=replace-with-a-long-random-alphanumeric-secret
REDIS_PASSWORD=replace-with-a-long-random-alphanumeric-secret

REDIS_DB=0
DISABLE_FALLBACK_MODE=true
ANALYSIS_WORKER_POOL_SIZE=1
ANALYSIS_JOB_TIMEOUT=1800000
ANALYSIS_JOB_MAX_ATTEMPTS=3
ANALYZER_MAX_FRAMES=

MAX_FILE_SIZE=500000000
STORAGE_BACKEND=local
UPLOAD_DIR=/app/server/uploads
TMP_ANALYSIS_DIR=/app/server/tmp_analysis
CV_DIR=/app/server/cv
PYTHON_BIN=/opt/venv/bin/python3
