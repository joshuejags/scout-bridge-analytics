# Database
MONGODB_URI=mongodb://localhost:27017/scout-bridge-analytics
MONGODB_USER=
MONGODB_PASSWORD=

# Server
PORT=5000
NODE_ENV=development

# JWT. Generate a real value with: node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=your_jwt_secret_key_here

# File Upload
MAX_FILE_SIZE=500000000
UPLOAD_DIR=./uploads

# Storage backend for uploaded video files. "local" (default) writes to
# UPLOAD_DIR on this machine's disk; no other vars below are needed. Set
# to "s3" to store on S3 or an S3-compatible provider (MinIO, Cloudflare
# R2, DigitalOcean Spaces) instead; requires S3_BUCKET at minimum.
STORAGE_BACKEND=local
S3_BUCKET=
S3_REGION=us-east-1
# Only needed for an S3-compatible provider that isn't AWS itself (MinIO,
# R2, Spaces). Leave unset when using real AWS S3.
S3_ENDPOINT=
# Leave unset to use the AWS SDK's normal credential chain (IAM role,
# shared credentials file, etc.). Only set these for static keys.
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Computer Vision
PYTHON_ENV_PATH=./venv
YOLO_MODEL=yolov8n.pt

# Video import from a URL (YouTube, Instagram, TikTok, Facebook, X/Twitter,
# Vimeo). Sane defaults apply if left unset; see server/cv/download_video.py.
URL_IMPORT_MAX_DURATION_SECONDS=3600
URL_IMPORT_TIMEOUT_MS=600000

# Frontend
REACT_APP_API_URL=http://localhost:5000/api
# Used to build password-reset / email-verification links sent to users
CLIENT_URL=http://localhost:3000

# Email (password reset + verification). Checked in this order: Resend
# first, then SMTP, then (if neither is set) emails are logged to the
# server console instead of sent. Fine for local dev. Not fine for real
# users. See the Email section in README.md for setup steps, including how
# to use Gmail with an app password as the SMTP fallback.

# Preferred. Sign up at resend.com, verify a sending domain, and create an
# API key.
RESEND_API_KEY=

# Fallback. Any SMTP provider works here too: SES, SendGrid, Postmark,
# Gmail (with an app password, not your normal login password), etc.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=Scout Bridge Analytics <no-reply@yourdomain.com>

# Error tracking (Sentry). Leave unset to only log errors to the server
# console (fine for local dev; for production, create a free Sentry
# project and paste its DSN here; see server/utils/errorTracking.js).
SENTRY_DSN=
# Same idea, client-side. A separate Sentry project/DSN (or the same one,
# Sentry supports both) since this is baked into the browser bundle at
# build time like the other REACT_APP_* vars.
REACT_APP_SENTRY_DSN=

# Database backups (scripts/backupDatabase.js, run on a schedule by
# .github/workflows/backup.yml); see "Backups" in README.md. Deliberately
# a separate bucket from S3_BUCKET above (video storage), reusing the same
# S3_REGION/S3_ENDPOINT/S3_ACCESS_KEY_ID/S3_SECRET_ACCESS_KEY credentials.
BACKUP_S3_BUCKET=
BACKUP_RETENTION_DAYS=30
